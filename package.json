{
  "name": "zeus-ide",
  "version": "0.2.0",
  "private": true,
  "description": "Editor de código desktop open source com Monaco e terminal integrado",
  "license": "MIT",
  "author": "Código Roxo (https://www.youtube.com/@codigoroxo)",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodigoRoxo/ZeusIDE.git"
  },
  "homepage": "https://github.com/CodigoRoxo/ZeusIDE#readme",
  "bugs": {
    "url": "https://github.com/CodigoRoxo/ZeusIDE/issues"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "release": "npm run build && electron-builder --win nsis portable --publish always"
  },
  "build": {
    "appId": "com.zeus.ide",
    "productName": "Zeus IDE",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node-pty/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zeus IDE",
      "artifactName": "ZeusIDE-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CodigoRoxo",
        "repo": "ZeusIDE",
        "releaseType": "draft"
      }
    ],
    "portable": {
      "artifactName": "ZeusIDE-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
